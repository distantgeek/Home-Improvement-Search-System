{
  "name": "hiss-tests",
  "description": "E2E test tooling only — index.html has no build step or runtime dependencies",
  "private": true,
  "scripts": {
    "test": "sh scripts/test-container.sh",
    "test:report": "playwright show-report",
    "lint": "sh scripts/lint.sh",
    "sast": "sh scripts/sast.sh",
    "retire": "sh scripts/retire.sh",
    "verify": "npm audit && npm audit signatures",
    "audit:all": "npm run verify && npm run lint && npm run retire && npm run sast"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "eslint": "9.39.4",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "3.0.1",
    "retire": "5.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
