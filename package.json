{
  "name": "hiss-tests",
  "description": "E2E test tooling only — index.html has no build step or runtime dependencies",
  "private": true,
  "scripts": {
    "test": "sh scripts/test-container.sh",
    "test:report": "playwright show-report",
    "lint": "sh scripts/lint.sh",
    "sast": "sh scripts/sast.sh",
    "retire": "sh scripts/retire.sh",
    "security:python": "sh scripts/bandit.sh",
    "security:shell": "sh scripts/shellcheck.sh",
    "security:supplychain": "sh scripts/pip-audit.sh",
    "fmt:shell": "sh scripts/shfmt.sh fix",
    "fmt:check": "sh scripts/shfmt.sh check",
    "verify": "npm audit && npm audit signatures",
    "audit:all": "npm run verify && npm run lint && npm run sast && npm run retire && npm run security:python && npm run security:supplychain && npm run security:shell && npm run fmt:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "eslint": "9.39.4",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "3.0.1",
    "retire": "5.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
