# Meilisearch
MEILI_MASTER_KEY=change-me-at-least-16-chars

# Path to the Docker secret file containing the Meilisearch search key.
# Create the secret file (never commit it):
#   mkdir -p secrets && chmod 700 secrets
#   echo -n 'your-key-here' > secrets/meili_key && chmod 600 secrets/meili_key
# To create the key via API:
#   curl -X POST http://localhost:7700/keys \
#     -H "Authorization: Bearer $MEILI_MASTER_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"HISS Frontend Key","actions":["search","stats.get"],"indexes":["events"],"expiresAt":null}'
MEILI_SECRET_FILE=./secrets/meili_key

# API keys
SERPER_API_KEY=
EVENTBRITE_API_KEY=

# Pipeline schedule (cron, default: weekly Sunday 3am)
PIPELINE_SCHEDULE=0 3 * * 0

# Set to 'true' to test pipeline without writing to Meilisearch or SQLite
DRY_RUN=false

# NPM external Docker network name (run: docker network ls)
NPM_NETWORK_NAME=your_npm_network_name
