# Meilisearch
MEILI_MASTER_KEY=change-me-at-least-16-chars

# Path to the Docker secret file used by the nginx proxy.
# The file must contain exactly one nginx directive (not just the key value):
#   proxy_set_header Authorization "Bearer <your-key-here>";
# nginx includes this file natively — no scripts, no env vars.
#
# Setup (never commit the secrets/ directory):
#   mkdir -p secrets && chmod 700 secrets
#   printf 'proxy_set_header Authorization "Bearer <your-key-here>";' \
#     > secrets/meili_auth_header && chmod 600 secrets/meili_auth_header
#
# To create the Meilisearch key via API:
#   curl -X POST http://localhost:7700/keys \
#     -H "Authorization: Bearer $MEILI_MASTER_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"HISS Frontend Key","actions":["search","stats.get"],"indexes":["events"],"expiresAt":null}'
MEILI_SECRET_FILE=./secrets/meili_auth_header

# API keys
SERPER_API_KEY=
EVENTBRITE_API_KEY=

# Pipeline schedule (cron, default: weekly Sunday 3am)
PIPELINE_SCHEDULE=0 3 * * 0

# Set to 'true' to test pipeline without writing to Meilisearch or SQLite
DRY_RUN=false

# NPM external Docker network name (run: docker network ls)
NPM_NETWORK_NAME=your_npm_network_name
